<%- include('partials/head') %>
<div class="app-container" style="justify-content: center; align-items: center; min-height: 100vh;">
  <div class="card" style="max-width: 480px; width: 90%; text-align: center; padding: 40px 24px;">
    <div style="font-size: 3.5rem; margin-bottom: 16px;">⚠️</div>
    <h1 style="font-size: 1.8rem; margin-bottom: 8px;"><%= status || 500 %></h1>
    <h2 style="font-size: 1.1rem; color: var(--text-muted); margin-bottom: 20px;"><%= message || '오류가 발생했습니다.' %></h2>
    <% if (stack) { %>
      <pre style="text-align: left; background: rgba(0,0,0,0.3); padding: 12px; border-radius: 8px; font-size: 0.75rem; color: #F87171; overflow-x: auto; margin-bottom: 24px;"><%= stack %></pre>
    <% } %>
    <a href="/dashboard" class="btn btn-primary">대시보드로 돌아가기</a>
  </div>
</div>
<%- include('partials/footer') %>
