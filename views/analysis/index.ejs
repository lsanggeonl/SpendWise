<%- include('../partials/head') %>

<div class="app-container">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/header') %>

    <main class="content-body">
      <%- include('../partials/alerts') %>

      <!-- Mode / Tab Switcher -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; border-bottom: 1px solid var(--border-color); padding-bottom: 14px;">
        <div style="display: flex; gap: 12px;">
          <a
            href="/analysis?month=<%= yearMonth %>&tab=diagnosis"
            class="btn <%= (!query.tab || query.tab === 'diagnosis') ? 'btn-primary' : 'btn-secondary' %>"
          >
            🧬 소비 습관 정밀 진단 (100점 점수)
          </a>
          <a
            href="/analysis?month=<%= yearMonth %>&tab=patterns"
            class="btn <%= query.tab === 'patterns' ? 'btn-primary' : 'btn-secondary' %>"
          >
            🔍 소비 패턴 및 과소비·소액결제 탐지
          </a>
        </div>

        <form action="/analysis/recalculate" method="POST" style="margin: 0;">
          <input type="hidden" name="yearMonth" value="<%= yearMonth %>">
          <button type="submit" class="btn btn-secondary btn-sm" title="실제 거래 데이터를 기반으로 최신 리포트 재산출">
            🔄 최신 데이터 즉시 재분석
          </button>
        </form>
      </div>

      <% const isPatternsTab = query.tab === 'patterns'; %>

      <% if (!isPatternsTab) { %>
        <!-- ========================================== -->
        <!-- TAB 1: SPENDING HABIT 100-POINT DIAGNOSIS  -->
        <!-- ========================================== -->

        <!-- Top Habit Score Hero Card -->
        <div class="card" style="margin-bottom: 28px; background: linear-gradient(135deg, rgba(30, 41, 59, 0.7) 0%, rgba(15, 23, 42, 0.9) 100%);">
          <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px;">
            <div style="display: flex; align-items: center; gap: 28px;">
              <div class="score-badge-huge">
                <span class="score-number"><%= diagnosis.habitScore %></span>
                <span class="score-unit">/ 100점 만점</span>
              </div>
              <div>
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
                  <h2 style="font-size: 1.4rem; font-weight: 700;"><%= yearMonth %> 소비 습관 진단 결과</h2>
                  <span class="badge badge-<%= diagnosis.gradeBadge %>" style="font-size: 0.9rem; padding: 4px 12px;">
                    등급: <%= diagnosis.grade %>
                  </span>
                </div>
                <p style="font-size: 0.9rem; color: #CBD5E1; max-width: 650px; line-height: 1.6;">
                  <%= diagnosis.feedbackSummary %>
                </p>
              </div>
            </div>

            <!-- Quick Metrics Summary -->
            <div style="display: flex; gap: 16px; border-left: 1px solid var(--border-color); padding-left: 24px;">
              <div>
                <div style="font-size: 0.75rem; color: var(--text-muted);">총 지출액</div>
                <div style="font-size: 1.15rem; font-weight: 700; color: #F87171;"><%= formatMoney(diagnosis.totalExpense) %></div>
              </div>
              <div>
                <div style="font-size: 0.75rem; color: var(--text-muted);">월말 예상 지출</div>
                <div style="font-size: 1.15rem; font-weight: 700; color: #FCD34D;"><%= formatMoney(diagnosis.expectedMonthEndExpense) %></div>
              </div>
            </div>
          </div>
        </div>

        <!-- 4 Pillars Breakdown & Radar Visualization Grid -->
        <div class="charts-grid-2">
          <!-- 4 Pillars Detailed Rationale Cards -->
          <div>
            <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 16px;">
              📑 4대 평가 영역별 채점 결과 및 산출 근거
            </h3>

            <div style="display: flex; flex-direction: column; gap: 14px;">
              <% const b = diagnosis.scoreBreakdown; %>

              <!-- 1. Budget Adherence (35 pts) -->
              <div class="breakdown-card">
                <div class="breakdown-card-header">
                  <span class="breakdown-title">1. 예산 준수도 (한도 관리 통제력)</span>
                  <span class="breakdown-score"><%= b.budgetAdherence.score %> / 35점</span>
                </div>
                <div class="progress-bar-bg" style="height: 6px;">
                  <div class="progress-bar-fill fill-safe" style="width: <%= (b.budgetAdherence.score / 35) * 100 %>%;"></div>
                </div>
                <div class="breakdown-comment">
                  <strong>평가 근거:</strong> <%= b.budgetAdherence.comment %>
                </div>
              </div>

              <!-- 2. Savings Rate (25 pts) -->
              <div class="breakdown-card">
                <div class="breakdown-card-header">
                  <span class="breakdown-title">2. 저축/잉여율 (자산 형성 기여도)</span>
                  <span class="breakdown-score"><%= b.savingsRate.score %> / 25점</span>
                </div>
                <div class="progress-bar-bg" style="height: 6px;">
                  <div class="progress-bar-fill fill-safe" style="width: <%= (b.savingsRate.score / 25) * 100 %>%;"></div>
                </div>
                <div class="breakdown-comment">
                  <strong>평가 근거:</strong> <%= b.savingsRate.comment %>
                </div>
              </div>

              <!-- 3. Overspending Control (20 pts) -->
              <div class="breakdown-card">
                <div class="breakdown-card-header">
                  <span class="breakdown-title">3. 과소비 억제도 (고액 돌발 지출 통제)</span>
                  <span class="breakdown-score"><%= b.overspendingControl.score %> / 20점</span>
                </div>
                <div class="progress-bar-bg" style="height: 6px;">
                  <div class="progress-bar-fill fill-safe" style="width: <%= (b.overspendingControl.score / 20) * 100 %>%;"></div>
                </div>
                <div class="breakdown-comment">
                  <strong>평가 근거:</strong> <%= b.overspendingControl.comment %>
                </div>
              </div>

              <!-- 4. Micro-transactions Management (20 pts) -->
              <div class="breakdown-card">
                <div class="breakdown-card-header">
                  <span class="breakdown-title">4. 소액 반복 결제 관리도 (티끌 누수 방지)</span>
                  <span class="breakdown-score"><%= b.microTransactionManagement.score %> / 20점</span>
                </div>
                <div class="progress-bar-bg" style="height: 6px;">
                  <div class="progress-bar-fill fill-safe" style="width: <%= (b.microTransactionManagement.score / 20) * 100 %>%;"></div>
                </div>
                <div class="breakdown-comment">
                  <strong>평가 근거:</strong> <%= b.microTransactionManagement.comment %>
                </div>
              </div>
            </div>
          </div>

          <!-- Radar Chart Card -->
          <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div class="card-header">
              <div>
                <div class="card-title">🕸️ 소비 습관 밸런스 레이더</div>
                <div class="card-subtitle">4개 차원별 균형 발달 상태 점검</div>
              </div>
            </div>
            <div style="height: 320px; position: relative;">
              <canvas id="habitRadarChart"></canvas>
            </div>
            <div style="font-size: 0.8rem; color: var(--text-dim); text-align: center; margin-top: 12px;">
              💡 4개 축이 고르게 바깥쪽에 위치할수록 건강한 금융 습관을 보유한 상태입니다.
            </div>
          </div>
        </div>

      <% } else { %>
        <!-- ========================================== -->
        <!-- TAB 2: SPENDING PATTERNS & DETECTION       -->
        <!-- ========================================== -->

        <!-- Month-End Prediction Formula Deep Dive Card -->
        <div class="card" style="margin-bottom: 28px;">
          <div class="card-header">
            <div>
              <div class="card-title">🔮 월말 예상 지출 산출 모델 (수학적 통계 기반)</div>
              <div class="card-subtitle">임의의 난수가 아닌 현재까지의 실제 일평균 지출 추이를 기반으로 계산됩니다.</div>
            </div>
            <span class="badge badge-warning" style="font-size: 0.85rem;">
              예상 총액: <%= formatMoney(diagnosis.expectedMonthEndExpense) %>
            </span>
          </div>

          <% if (typeof diagnosis.expectedData === 'object') { %>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin: 16px 0;">
              <div style="background: var(--bg-input); padding: 14px; border-radius: var(--radius-sm);">
                <div style="font-size: 0.78rem; color: var(--text-muted);">현재까지 누적 지출</div>
                <div style="font-size: 1.3rem; font-weight: 700; color: #fff; margin-top: 4px;">
                  <%= formatMoney(diagnosis.totalExpense) %>
                </div>
                <div style="font-size: 0.72rem; color: var(--text-dim); margin-top: 2px;">경과 일수: <%= diagnosis.expectedData.daysElapsed %>일</div>
              </div>

              <div style="background: var(--bg-input); padding: 14px; border-radius: var(--radius-sm);">
                <div style="font-size: 0.78rem; color: var(--text-muted);">하루 평균 소비액 (Daily Avg)</div>
                <div style="font-size: 1.3rem; font-weight: 700; color: #FCD34D; margin-top: 4px;">
                  <%= formatMoney(diagnosis.expectedData.dailyAverage) %>
                </div>
                <div style="font-size: 0.72rem; color: var(--text-dim); margin-top: 2px;">누적지출 / 경과일수</div>
              </div>

              <div style="background: var(--bg-input); padding: 14px; border-radius: var(--radius-sm);">
                <div style="font-size: 0.78rem; color: var(--text-muted);">월말까지 남은 일수</div>
                <div style="font-size: 1.3rem; font-weight: 700; color: #60A5FA; margin-top: 4px;">
                  <%= diagnosis.expectedData.remainingDays %>일
                </div>
                <div style="font-size: 0.72rem; color: var(--text-dim); margin-top: 2px;">월 총 <%= diagnosis.expectedData.totalDays %>일 중</div>
              </div>

              <div style="background: var(--bg-input); padding: 14px; border-radius: var(--radius-sm);">
                <div style="font-size: 0.78rem; color: var(--text-muted);">월말 최종 예측 지출</div>
                <div style="font-size: 1.3rem; font-weight: 700; color: #F87171; margin-top: 4px;">
                  <%= formatMoney(diagnosis.expectedData.expectedTotal) %>
                </div>
                <div style="font-size: 0.72rem; color: var(--text-dim); margin-top: 2px;">현재지출 + (일평균 × 남은일수)</div>
              </div>
            </div>
          <% } %>
        </div>

        <!-- Overspending Detection Section -->
        <div class="card" style="margin-bottom: 28px;">
          <div class="card-header">
            <div>
              <div class="card-title">🚨 과소비 탐지 리포트 (단일 결제 <%= formatMoney(currentUser.overspending_threshold) %> 이상)</div>
              <div class="card-subtitle">기준 금액을 초과하여 발생한 고액 결제 건을 정밀 탐지합니다.</div>
            </div>
            <span class="badge badge-danger">
              총 <%= diagnosis.overspendingCount %>건 / 합계 <%= formatMoney(diagnosis.overspendingTotal) %>
            </span>
          </div>

          <% if (diagnosis.overspendingList && diagnosis.overspendingList.length > 0) { %>
            <div class="table-responsive">
              <table class="table">
                <thead>
                  <tr>
                    <th>일자</th>
                    <th>카테고리</th>
                    <th>가맹점 / 거래명</th>
                    <th>결제 수단</th>
                    <th>지출 금액</th>
                    <th>지출 비중</th>
                  </tr>
                </thead>
                <tbody>
                  <% diagnosis.overspendingList.forEach(tx => { %>
                    <tr>
                      <td style="color: var(--text-muted); font-size: 0.82rem;"><%= formatDate(tx.transaction_date) %></td>
                      <td>
                        <span style="display: inline-flex; align-items: center; gap: 6px;">
                          <span style="width: 8px; height: 8px; border-radius: 50%; background: <%= tx.category_color %>;"></span>
                          <%= tx.category_name %>
                        </span>
                      </td>
                      <td>
                        <strong style="color: #fff;"><%= tx.title %></strong>
                        <% if (tx.description) { %>
                          <div style="font-size: 0.75rem; color: var(--text-dim);"><%= tx.description %></div>
                        <% } %>
                      </td>
                      <td style="color: var(--text-muted); font-size: 0.82rem;"><%= tx.payment_method %></td>
                      <td>
                        <span class="amount-expense" style="font-size: 0.95rem;">
                          <%= formatMoney(tx.amount) %>
                        </span>
                      </td>
                      <td>
                        <span class="badge badge-danger">
                          <%= diagnosis.totalExpense > 0 ? ((tx.amount / diagnosis.totalExpense) * 100).toFixed(1) + '%' : '0%' %>
                        </span>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div style="text-align: center; padding: 36px; color: var(--success); font-size: 0.9rem;">
              🎉 축하합니다! 이번 달에는 설정된 과소비 기준(<%= formatMoney(currentUser.overspending_threshold) %>)을 초과한 지출이 없습니다.
            </div>
          <% } %>
        </div>

        <!-- Repeated Micro-transactions Detection Section -->
        <div class="card">
          <div class="card-header">
            <div>
              <div class="card-title">☕ 반복 소액 결제 탐지 리포트 (<%= formatMoney(currentUser.micro_tx_threshold) %> 이하)</div>
              <div class="card-subtitle">카페, 편의점, 간식 등 '티끌 지출'이 반복되어 발생하는 누수 요인을 집계합니다.</div>
            </div>
            <span class="badge badge-warning">
              총 <%= diagnosis.microTransactionCount %>건 / 합계 <%= formatMoney(diagnosis.microTransactionTotal) %>
            </span>
          </div>

          <% if (diagnosis.microList && diagnosis.microList.length > 0) { %>
            <div class="table-responsive">
              <table class="table">
                <thead>
                  <tr>
                    <th>거래 항목 / 가맹점</th>
                    <th>카테고리</th>
                    <th>반복 결제 횟수</th>
                    <th>건당 평균 금액</th>
                    <th>누적 결제 총액</th>
                    <th>마지막 결제일</th>
                  </tr>
                </thead>
                <tbody>
                  <% diagnosis.microList.forEach(m => { %>
                    <tr>
                      <td>
                        <strong style="color: #fff;"><%= m.title %></strong>
                      </td>
                      <td>
                        <span style="display: inline-flex; align-items: center; gap: 6px;">
                          <span style="width: 8px; height: 8px; border-radius: 50%; background: <%= m.category_color %>;"></span>
                          <%= m.category_name %>
                        </span>
                      </td>
                      <td>
                        <span class="badge <%= m.count >= 4 ? 'badge-warning-high' : 'badge-warning' %>">
                          <%= m.count %>회 반복
                        </span>
                      </td>
                      <td style="color: var(--text-muted); font-size: 0.85rem;">
                        <%= formatMoney(m.avg_amount) %>
                      </td>
                      <td>
                        <span style="color: #FCD34D; font-weight: 700;">
                          <%= formatMoney(m.total_amount) %>
                        </span>
                      </td>
                      <td style="color: var(--text-dim); font-size: 0.82rem;">
                        <%= formatDate(m.last_date) %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div style="text-align: center; padding: 36px; color: var(--text-muted); font-size: 0.9rem;">
              이번 달에는 탐지된 반복 소액 결제 내역이 없습니다.
            </div>
          <% } %>
        </div>

      <% } %>
    </main>
  </div>
</div>

<!-- Scripts for Analysis Charts -->
<script src="/js/analysis.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const scoreBreakdown = <%- JSON.stringify(diagnosis.scoreBreakdown || null) %>;
    initAnalysisCharts(scoreBreakdown, []);
  });
</script>

<%- include('../partials/footer') %>
