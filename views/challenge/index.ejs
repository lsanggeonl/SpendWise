<%- include('../partials/head') %>

<div class="app-container">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/header') %>

    <main class="content-body">
      <%- include('../partials/alerts') %>

      <!-- Top Summary Metrics Card -->
      <div class="card" style="margin-bottom: 28px; background: linear-gradient(135deg, rgba(30, 41, 59, 0.6) 0%, rgba(19, 27, 46, 0.8) 100%);">
        <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px;">
          <div>
            <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 4px;">🏆 절약 목표 및 금융 챌린지</h2>
            <p style="font-size: 0.85rem; color: var(--text-muted);">
              구체적인 절약 목표를 수립하고, 매일의 성과를 기록하여 소비 습관을 개선하세요.
            </p>
          </div>
          <button class="btn btn-primary" onclick="openModal('createGoalModal')">
            ➕ 새 챌린지 시작하기
          </button>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-color);">
          <div>
            <div style="font-size: 0.78rem; color: var(--text-muted);">진행 중인 챌린지</div>
            <div style="font-size: 1.4rem; font-weight: 700; color: #fff; margin-top: 2px;"><%= ongoingGoals.length %>개</div>
          </div>
          <div>
            <div style="font-size: 0.78rem; color: var(--text-muted);">총 목표 절약/저축액</div>
            <div style="font-size: 1.4rem; font-weight: 700; color: var(--primary-light); margin-top: 2px;"><%= formatMoney(totalTarget) %></div>
          </div>
          <div>
            <div style="font-size: 0.78rem; color: var(--text-muted);">현재까지 누적 달성액</div>
            <div style="font-size: 1.4rem; font-weight: 700; color: var(--success); margin-top: 2px;"><%= formatMoney(totalSaved) %></div>
          </div>
          <div>
            <div style="font-size: 0.78rem; color: var(--text-muted);">전체 평균 달성률</div>
            <div style="font-size: 1.4rem; font-weight: 700; color: #FCD34D; margin-top: 2px;"><%= overallProgress %>%</div>
          </div>
        </div>
      </div>

      <!-- Filter Tabs -->
      <div style="display: flex; gap: 10px; margin-bottom: 20px;">
        <a href="/challenges" class="btn btn-sm <%= !statusFilter ? 'btn-primary' : 'btn-secondary' %>">전체 보기 (<%= goals.length %>)</a>
        <a href="/challenges?status=ongoing" class="btn btn-sm <%= statusFilter === 'ongoing' ? 'btn-primary' : 'btn-secondary' %>">진행 중 (<%= ongoingGoals.length %>)</a>
        <a href="/challenges?status=completed" class="btn btn-sm <%= statusFilter === 'completed' ? 'btn-primary' : 'btn-secondary' %>">달성 완료 (<%= completedGoals.length %>)</a>
      </div>

      <!-- Goals Cards Grid -->
      <div class="goals-grid">
        <% if (goals && goals.length > 0) { %>
          <% goals.forEach(goal => { %>
            <div class="goal-card">
              <div>
                <!-- Status Badge -->
                <div class="goal-badge-status">
                  <% if (goal.status === 'completed') { %>
                    <span class="badge badge-success">달성 완료 🎉</span>
                  <% } else if (goal.status === 'failed' || goal.isExpired) { %>
                    <span class="badge badge-danger">기한 만료 ⚠️</span>
                  <% } else { %>
                    <span class="badge badge-primary">진행 중 (D-<%= goal.daysLeft %>)</span>
                  <% } %>
                </div>

                <div class="goal-title"><%= goal.title %></div>
                <div class="goal-category">
                  🏷️ <%= goal.category %> | 📅 <%= formatDate(goal.start_date) %> ~ <%= formatDate(goal.end_date) %>
                </div>

                <div class="goal-amounts">
                  <span style="color: var(--text-muted);">달성률: <strong style="color: #fff;"><%= goal.progress %>%</strong></span>
                  <span style="color: var(--text-muted);"><%= formatMoney(goal.current_amount) %> / <%= formatMoney(goal.target_amount) %></span>
                </div>

                <!-- Progress Bar -->
                <div class="progress-bar-bg" style="height: 10px; margin-bottom: 16px;">
                  <div
                    class="progress-bar-fill"
                    style="width: <%= goal.progress %>%; background: <%= goal.status === 'completed' ? 'var(--success)' : 'linear-gradient(90deg, #6366F1, #8B5CF6)' %>;"
                  ></div>
                </div>
              </div>

              <!-- Card Action Buttons -->
              <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 14px; border-top: 1px solid var(--border-color);">
                <div>
                  <% if (goal.status === 'ongoing') { %>
                    <button
                      class="btn btn-success btn-sm"
                      onclick="openAddProgressModal('<%= goal.id %>', '<%= goal.title %>', '<%= goal.target_amount - goal.current_amount %>')"
                    >
                      💰 절약/저축 추가
                    </button>
                  <% } %>
                </div>

                <form action="/challenges/<%= goal.id %>/delete" method="POST" onsubmit="return confirm('이 챌린지를 삭제하시겠습니까?');" style="margin: 0;">
                  <button type="submit" class="btn btn-secondary btn-sm" style="color: #F87171;" title="삭제">
                    🗑️ 삭제
                  </button>
                </form>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="card" style="grid-column: 1 / -1; text-align: center; padding: 48px; color: var(--text-dim);">
            등록된 챌린지가 없습니다. '새 챌린지 시작하기' 버튼을 눌러 목표를 세워보세요!
          </div>
        <% } %>
      </div>
    </main>
  </div>
</div>

<!-- Modal 1: Add Savings Progress -->
<div class="modal-backdrop" id="addProgressModal">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">💰 절약/저축 금액 추가</h3>
      <button class="modal-close" onclick="closeModal('addProgressModal')">&times;</button>
    </div>
    <form id="addProgressForm" action="" method="POST">
      <div class="modal-body">
        <input type="hidden" id="progressGoalId" name="goalId" value="">
        <div style="margin-bottom: 16px;">
          <h4 id="progressGoalTitle" style="color: #fff; font-size: 1.1rem; margin-bottom: 4px;">목표명</h4>
          <span id="progressGoalRemaining" class="badge badge-warning">0원 남음</span>
        </div>

        <div class="form-group">
          <label class="form-label" for="addAmountInput">이번에 저축/절약한 금액 (원)</label>
          <input
            type="number"
            id="addAmountInput"
            name="amount"
            class="form-control"
            placeholder="50000"
            required
            step="1000"
            min="1"
          >
          <small style="color: var(--text-dim); font-size: 0.75rem; margin-top: 4px; display: block;">
            외식 줄이기, 커피 덜 마시기 등으로 아낀 금액을 입력하면 달성률이 증가합니다.
          </small>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('addProgressModal')">취소</button>
        <button type="submit" class="btn btn-primary">저축 반영하기</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal 2: Create New Saving Goal / Challenge -->
<div class="modal-backdrop" id="createGoalModal">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">🏆 새 절약 목표 및 챌린지 등록</h3>
      <button class="modal-close" onclick="closeModal('createGoalModal')">&times;</button>
    </div>
    <form action="/challenges" method="POST">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label" for="goalTitle">챌린지 / 목표 명칭 *</label>
          <input
            type="text"
            id="goalTitle"
            name="title"
            class="form-control"
            placeholder="예: 카페 음료 5만원 줄이기, 비상금 100만원 모으기"
            required
          >
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="targetAmount">목표 금액 (원) *</label>
            <input
              type="number"
              id="targetAmount"
              name="targetAmount"
              class="form-control"
              placeholder="1000000"
              required
              step="10000"
              min="1"
            >
          </div>
          <div class="form-group">
            <label class="form-label" for="currentAmount">현재 모은 금액 (원)</label>
            <input
              type="number"
              id="currentAmount"
              name="currentAmount"
              class="form-control"
              value="0"
              step="10000"
              min="0"
            >
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="startDate">시작일 *</label>
            <input
              type="date"
              id="startDate"
              name="startDate"
              class="form-control"
              value="<%= new Date().toISOString().split('T')[0] %>"
              required
            >
          </div>
          <div class="form-group">
            <label class="form-label" for="endDate">종료일 *</label>
            <input
              type="date"
              id="endDate"
              name="endDate"
              class="form-control"
              required
            >
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="goalCategory">목표 분류</label>
          <select id="goalCategory" name="category" class="form-control">
            <option value="비상금 모으기">비상금 모으기</option>
            <option value="지출 절감">불필요 지출 절감</option>
            <option value="여행/휴가">여행 및 휴가</option>
            <option value="전자기기/쇼핑">전자기기 및 쇼핑</option>
            <option value="자기계발/교육">자기계발 및 교육</option>
            <option value="일반 저축">일반 저축</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('createGoalModal')">취소</button>
        <button type="submit" class="btn btn-primary">챌린지 시작</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
