<%- include('../partials/head') %>

<div class="app-container">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/header') %>

    <main class="content-body">
      <%- include('../partials/alerts') %>

      <!-- Filter Bar -->
      <div class="card" style="margin-bottom: 24px; padding: 18px 24px;">
        <form method="GET" action="/transactions" style="display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-end;">
          <div style="flex: 1; min-width: 150px;">
            <label class="form-label" style="margin-bottom: 4px;">조회 연월</label>
            <input type="month" name="month" class="form-control" value="<%= filters.yearMonth || '' %>">
          </div>

          <div style="flex: 1; min-width: 130px;">
            <label class="form-label" style="margin-bottom: 4px;">구분</label>
            <select name="type" class="form-control">
              <option value="">전체 구분</option>
              <option value="income" <%= filters.type === 'income' ? 'selected' : '' %>>수입만</option>
              <option value="expense" <%= filters.type === 'expense' ? 'selected' : '' %>>지출만</option>
            </select>
          </div>

          <div style="flex: 1; min-width: 150px;">
            <label class="form-label" style="margin-bottom: 4px;">카테고리</label>
            <select name="categoryId" class="form-control">
              <option value="">전체 카테고리</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>" <%= filters.categoryId == cat.id ? 'selected' : '' %>>
                  <%= cat.type === 'income' ? '🟢' : '🔴' %> <%= cat.name %>
                </option>
              <% }) %>
            </select>
          </div>

          <div style="flex: 2; min-width: 200px;">
            <label class="form-label" style="margin-bottom: 4px;">검색어</label>
            <input type="text" name="keyword" class="form-control" placeholder="거래명 또는 메모 검색" value="<%= filters.keyword || '' %>">
          </div>

          <div style="display: flex; gap: 8px;">
            <button type="submit" class="btn btn-primary" style="padding: 10px 18px;">
              🔍 필터 검색
            </button>
            <a href="/transactions" class="btn btn-secondary" style="padding: 10px 14px;" title="필터 초기화">
              초기화
            </a>
          </div>
        </form>
      </div>

      <!-- Transactions List Card -->
      <div class="card">
        <div class="card-header">
          <div>
            <div class="card-title">📋 수입·지출 거래 원장</div>
            <div class="card-subtitle">총 <%= pagination.totalCount %>건의 내역이 조회되었습니다.</div>
          </div>
          <a href="/transactions/new" class="btn btn-primary btn-sm">
            ➕ 새 거래 등록
          </a>
        </div>

        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>일자</th>
                <th>구분</th>
                <th>카테고리</th>
                <th>거래 내용 / 가맹점</th>
                <th>결제 수단</th>
                <th>금액</th>
                <th style="text-align: right;">관리</th>
              </tr>
            </thead>
            <tbody>
              <% if (transactions && transactions.length > 0) { %>
                <% transactions.forEach(tx => { %>
                  <tr>
                    <td style="color: var(--text-muted); font-size: 0.82rem; white-space: nowrap;">
                      <%= formatDate(tx.transaction_date) %>
                    </td>
                    <td>
                      <span class="badge <%= tx.type === 'income' ? 'badge-success' : 'badge-danger' %>">
                        <%= tx.type === 'income' ? '수입' : '지출' %>
                      </span>
                    </td>
                    <td>
                      <span style="display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;">
                        <span style="width: 8px; height: 8px; border-radius: 50%; background: <%= tx.category_color %>;"></span>
                        <%= tx.category_name %>
                      </span>
                    </td>
                    <td>
                      <strong style="color: #fff;"><%= tx.title %></strong>
                      <% if (tx.is_fixed) { %>
                        <span class="badge badge-info" style="font-size: 0.68rem; margin-left: 4px;">고정</span>
                      <% } %>
                      <% if (tx.type === 'expense' && tx.amount >= currentUser.overspending_threshold) { %>
                        <span class="badge badge-warning-high" style="font-size: 0.68rem; margin-left: 4px;">과소비 주의</span>
                      <% } %>
                      <% if (tx.description) { %>
                        <div style="font-size: 0.78rem; color: var(--text-dim); margin-top: 2px;"><%= tx.description %></div>
                      <% } %>
                    </td>
                    <td style="color: var(--text-muted); font-size: 0.82rem; white-space: nowrap;">
                      <%= tx.payment_method %>
                    </td>
                    <td>
                      <span class="<%= tx.type === 'income' ? 'amount-income' : 'amount-expense' %>" style="white-space: nowrap;">
                        <%= tx.type === 'income' ? '+' : '-' %><%= formatMoney(tx.amount) %>
                      </span>
                    </td>
                    <td style="text-align: right; white-space: nowrap;">
                      <a href="/transactions/<%= tx.id %>/edit" class="btn btn-secondary btn-sm" style="padding: 4px 8px; font-size: 0.75rem;">
                        수정
                      </a>
                      <form action="/transactions/<%= tx.id %>/delete" method="POST" style="display: inline-block; margin-left: 4px;" onsubmit="return confirm('이 거래 내역을 삭제하시겠습니까?');">
                        <button type="submit" class="btn btn-danger btn-sm" style="padding: 4px 8px; font-size: 0.75rem;">
                          삭제
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" style="text-align: center; color: var(--text-dim); padding: 48px;">
                    조회된 거래 내역이 없습니다. 새로운 수입 또는 지출을 등록해보세요!
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <% if (pagination.totalPages > 1) { %>
          <div style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border-color);">
            <% if (pagination.hasPrev) { %>
              <a href="/transactions?page=<%= pagination.page - 1 %>&month=<%= filters.yearMonth || '' %>&type=<%= filters.type || '' %>&categoryId=<%= filters.categoryId || '' %>&keyword=<%= filters.keyword || '' %>" class="btn btn-secondary btn-sm">
                ← 이전
              </a>
            <% } %>

            <span style="font-size: 0.85rem; color: var(--text-muted); padding: 0 12px;">
              페이지 <strong><%= pagination.page %></strong> / <%= pagination.totalPages %>
            </span>

            <% if (pagination.hasNext) { %>
              <a href="/transactions?page=<%= pagination.page + 1 %>&month=<%= filters.yearMonth || '' %>&type=<%= filters.type || '' %>&categoryId=<%= filters.categoryId || '' %>&keyword=<%= filters.keyword || '' %>" class="btn btn-secondary btn-sm">
                다음 →
              </a>
            <% } %>
          </div>
        <% } %>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
